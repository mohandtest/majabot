# Copy this file to .env for temporary hosted-provider configuration.
# The local provider is built into Maja and needs no URL here.

# Used by: @Maja set-provider aarmo
OLLAMA_URL=
MODEL=

# Optional: required by some hosted Ollama-compatible APIs.
# OLLAMA_API_KEY=

# Optional: defaults to /api/tags beside OLLAMA_URL.
# OLLAMA_TAGS_URL=

# Optional: seconds to wait for a model response. Increase this for reasoning models.
OLLAMA_TIMEOUT=120
